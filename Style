:root {
  --bg1: #07131d;
  --bg2: #122a3d;
  --panel: rgba(15, 22, 31, 0.84);
  --panel-strong: rgba(10, 16, 21, 0.96);
  --field: #1aa65d;
  --field-dark: #0d723d;
  --line: rgba(255, 255, 255, 0.1);
  --text: #edf4ff;
  --muted: #a7bfd7;
  --gold: #f7d76b;
  --blue: #6bb7ff;
  --danger: #ff5a5a;
  --danger-dark: #af1c1c;
  --green: #22c55e;
  --shadow: rgba(0, 0, 0, 0.35);
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  height: 100%;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top, rgba(109, 142, 179, 0.25), transparent 30%),
    linear-gradient(160deg, var(--bg1), var(--bg2));
  color: var(--text);
}

body {
  min-height: 100vh;
  display: grid;
  place-items: center;
  overflow: hidden;
}

button {
  font: inherit;
}

.hidden {
  display: none !important;
}

.screen {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(2, 8, 12, 0.68);
  backdrop-filter: blur(5px);
  z-index: 35;
}

.start-panel,
.result-panel {
  width: min(92vw, 540px);
  background: linear-gradient(180deg, rgba(16, 23, 31, 0.95), rgba(9, 14, 20, 0.98));
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: 0 28px 60px rgba(0, 0, 0, 0.38);
  padding: 30px 28px;
  text-align: center;
}

.title-wrap {
  margin-bottom: 18px;
}

.mini-label {
  display: inline-block;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--gold);
  margin-bottom: 8px;
}

h1, h2 {
  margin: 0;
}

h1 {
  font-size: clamp(2.2rem, 4vw, 4rem);
  line-height: 1.05;
  letter-spacing: 0.04em;
}

.subtitle {
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--muted);
  margin: 0 0 18px;
}

.start-info {
  display: grid;
  gap: 10px;
  text-align: left;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 14px 16px;
  margin-bottom: 20px;
  color: var(--text);
}

.primary-btn {
  border: none;
  border-radius: 14px;
  padding: 16px 24px;
  background: linear-gradient(180deg, var(--green), #0d8d43);
  color: white;
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  box-shadow: 0 12px 22px rgba(49, 164, 96, 0.38);
  transition: transform 0.15s ease, filter 0.15s ease;
}

.primary-btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.08);
}

.app-shell {
  width: min(1180px, 96vw);
  min-height: 620px;
  background: rgba(9, 15, 22, 0.72);
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: 0 26px 60px var(--shadow);
  overflow: hidden;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 22px;
  background: linear-gradient(180deg, rgba(16, 23, 31, 0.96), rgba(9, 14, 20, 0.96));
  border-bottom: 1px solid var(--line);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-badge {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  font-weight: 900;
  background: linear-gradient(180deg, #f8d46a, #dfad1d);
  color: #10212e;
  box-shadow: inset 0 -5px 8px rgba(0,0,0,0.17);
}

.brand-text {
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: clamp(1rem, 1.8vw, 1.5rem);
}

.scoreboard {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px 18px;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--line);
  border-radius: 16px;
  min-width: 260px;
  justify-content: center;
}

.team {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
}

.team span {
  color: var(--muted);
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.team strong {
  font-size: clamp(1.5rem, 3vw, 2rem);
  min-width: 32px;
  text-align: center;
}

.divider {
  font-size: 1.8rem;
  color: var(--gold);
  font-weight: 800;
}

.emergency-btn,
.restart-btn {
  border: none;
  border-radius: 14px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform 0.15s ease, filter 0.15s ease;
}

.emergency-btn {
  background: linear-gradient(180deg, var(--danger), var(--danger-dark));
  color: white;
  padding: 12px 18px;
  box-shadow: 0 10px 20px rgba(255, 90, 90, 0.32);
}

.restart-btn {
  width: 100%;
  background: linear-gradient(180deg, #38bdf8, #0f7ed8);
  color: white;
  padding: 12px 18px;
  margin-top: 12px;
}

.emergency-btn:hover,
.restart-btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.08);
}

.game-area {
  display: grid;
  grid-template-columns: 230px minmax(0, 1fr) 230px;
  gap: 18px;
  padding: 20px;
  background: rgba(13, 18, 24, 0.7);
}

.side-panel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.panel-box {
  background: linear-gradient(180deg, rgba(16, 26, 35, 0.96), rgba(12, 17, 22, 0.96));
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 16px 14px;
}

.panel-box h3 {
  margin: 0 0 10px;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--muted);
}

.panel-box p, .panel-box li {
  margin: 0;
  color: var(--text);
  line-height: 1.6;
  font-size: 0.96rem;
}

.panel-box ul {
  margin: 0;
  padding-left: 18px;
  color: var(--text);
}

.highscore-list {
  margin: 0;
  padding-left: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.highscore-list li {
  color: var(--gold);
  font-weight: 700;
}

.pitch-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pitch {
  position: relative;
  height: 580px;
  background:
    linear-gradient(180deg, rgba(18, 132, 74, 0.16), rgba(0,0,0,0.12)),
    linear-gradient(90deg, var(--field) 0%, var(--field) 50%, var(--field-dark) 100%);
  border: 2px solid rgba(255,255,255,0.12);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: inset 0 0 30px rgba(0,0,0,0.12);
}

.pitch::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    transparent 0%,
    transparent 49.4%,
    rgba(255,255,255,0.22) 49.4%,
    rgba(255,255,255,0.22) 50.6%,
    transparent 50.6%,
    transparent 100%
  );
}

.goal {
  position: absolute;
  width: 12px;
  height: 180px;
  top: 200px;
  background: rgba(255,255,255,0.64);
  border: 3px solid rgba(255,255,255,0.8);
  border-radius: 10px;
  z-index: 1;
}

.goal-left { left: 0; }
.goal-right { right: 0; }

.midline {
  position: absolute;
  left: 50%;
  top: 0;
  width: 3px;
  height: 100%;
  background: rgba(255,255,255,0.18);
  transform: translateX(-50%);
}

.center-circle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 130px;
  height: 130px;
  border: 3px solid rgba(255,255,255,0.2);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.ball {
  position: absolute;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #ffffff 0%, #edf0f0 30%, #c9d0d5 100%);
  border: 2px solid rgba(0,0,0,0.12);
  box-shadow: inset -5px -5px 10px rgba(0,0,0,0.15), 0 5px 12px rgba(0,0,0,0.25);
  z-index: 5;
}

.player {
  position: absolute;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 3px solid rgba(0,0,0,0.12);
  box-shadow: inset -7px -7px 12px rgba(0,0,0,0.1), 0 10px 16px rgba(0,0,0,0.2);
  z-index: 6;
}

.player::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 52%;
  transform: translate(-50%, -50%);
  width: 30px;
  height: 12px;
  border-radius: 18px;
  background: rgba(0,0,0,0.14);
}

.player-user {
  background: radial-gradient(circle at 32% 28%, #fff7d9, #f3c55f 36%, #cc8c16 100%);
}

.player-ai {
  background: radial-gradient(circle at 32% 28%, #edf7ff, #8dc4ff 35%, #3d7ad6 100%);
}

.hud {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.hud-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(17, 25, 32, 0.9);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 12px 16px;
}

.label {
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.09em;
  font-size: 0.75rem;
}

.hud-item strong {
  font-size: 1.4rem;
  color: var(--gold);
}

.result-badge {
  display: inline-block;
  background: rgba(247, 215, 107, 0.12);
  color: var(--gold);
  border: 1px solid rgba(247, 215, 107, 0.35);
  border-radius: 999px;
  padding: 8px 14px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.72rem;
  margin-bottom: 12px;
}

.result-score {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 18px 0 12px;
  font-size: 1.08rem;
  color: var(--muted);
}

.result-score strong {
  font-size: clamp(2rem, 4vw, 3rem);
  color: var(--text);
}

#resultMessage {
  margin: 0 0 22px;
  font-size: 1.1rem;
  color: var(--muted);
}

.overlay {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(2, 8, 12, 0.76);
  backdrop-filter: blur(4px);
  z-index: 30;
}

.overlay.hidden {
  display: none;
}

.calculator-panel {
  width: min(92vw, 380px);
  background: linear-gradient(180deg, #1a1f2b, #0d1118);
  border-radius: 22px;
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 24px 50px rgba(0,0,0,0.38);
  padding: 20px 18px 16px;
}

.calculator-panel h2 {
  margin: 0 0 8px;
  text-align: center;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.calculator-panel p {
  margin: 0 0 14px;
  text-align: center;
  color: #dbe9ff;
  line-height: 1.5;
}

.calc-display {
  background: rgba(4, 11, 18, 0.9);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  padding: 16px 12px;
  margin-bottom: 16px;
  text-align: right;
  font-size: clamp(1.8rem, 3vw, 2.7rem);
  font-weight: 800;
  min-height: 62px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.calc-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.calc-btn {
  border: none;
  border-radius: 12px;
  background: rgba(255,255,255,0.08);
  color: white;
  padding: 16px 10px;
  font-size: 1.4rem;
  font-weight: 800;
  cursor: pointer;
  transition: transform 0.15s ease, filter 0.15s ease;
}

.calc-btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.08);
}

.calc-btn.op {
  background: rgba(106, 136, 255, 0.2);
}

.calc-btn.accent {
  background: rgba(255, 184, 77, 0.16);
}

.calc-btn.equals {
  background: linear-gradient(180deg, rgba(34, 197, 94, 0.9), rgba(16, 119, 64, 0.9));
}

.zero {
  grid-column: span 2;
}

@media (max-width: 980px) {
  .game-area {
    grid-template-columns: 1fr;
  }

  .side-panel {
    order: 2;
  }

  .pitch-wrap {
    order: 1;
  }

  .pitch {
    height: 500px;
  }
}

@media (max-width: 600px) {
  .topbar {
    flex-wrap: wrap;
    justify-content: center;
  }

  .scoreboard {
    min-width: 220px;
  }

  .pitch {
    height: 420px;
  }

  .goal {
    height: 150px;
    top: 135px;
  }
}
