const startScreen = document.getElementById("startScreen");
const gameShell = document.getElementById("gameShell");
const resultScreen = document.getElementById("resultScreen");

const pitch = document.getElementById("pitch");
const ballEl = document.getElementById("ball");
const playerEl = document.getElementById("player");
const aiEl = document.getElementById("ai");
const scoreUserEl = document.getElementById("scoreUser");
const scoreAiEl = document.getElementById("scoreAi");
const timerEl = document.getElementById("timer");
const bestScoreEl = document.getElementById("bestScore");
const statusTextEl = document.getElementById("statusText");
const emergencyBtn = document.getElementById("emergencyBtn");
const restartBtn = document.getElementById("restartBtn");
const startBtn = document.getElementById("startBtn");
const playAgainBtn = document.getElementById("playAgainBtn");
const finalScoreEl = document.getElementById("finalScore");
const resultMessageEl = document.getElementById("resultMessage");
const highscoreList = document.getElementById("highscoreList");

const overlay = document.getElementById("calcOverlay");
const calcDisplay = document.getElementById("calcDisplay");
const calcHint = document.getElementById("calcHint");

const STORAGE_KEY = "headFootballHighscoreV1";

const state = {
  phase: "start",
  running: false,
  matchTime: 60,
  timer: 60,
  score: { user: 0, ai: 0 },
  player: { x: 140, y: 240, size: 52, vx: 0, vy: 0 },
  ai: { x: 760, y: 240, size: 52, vx: 0, vy: 0 },
  ball: { x: 470, y: 220, r: 13, vx: 5.2, vy: 3.4 },
  keys: { left: false, right: false, jump: false }
};

let lastTime = 0;
let calcExpression = "";

const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

function getHighscore() {
  try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
    return Array.isArray(saved) ? saved : [];
  } catch {
    return [];
  }
}

function saveHighscore(score) {
  const scores = getHighscore();
  scores.push(score);
  scores.sort((a, b) => b - a);
  const topScores = scores.slice(0, 5);
  localStorage.setItem(STORAGE_KEY, JSON.stringify(topScores));
  renderHighscore();
}

function renderHighscore() {
  const scores = getHighscore();
  highscoreList.innerHTML = "";

  if (!scores.length) {
    const li = document.createElement("li");
    li.textContent = "Noch keine Tore";
    highscoreList.appendChild(li);
    return;
  }

  scores.slice(0, 5).forEach((score, index) => {
    const li = document.createElement("li");
    li.textContent = `${index + 1}. ${score}`;
    highscoreList.appendChild(li);
  });
}

function getBestScore() {
  const scores = getHighscore();
  return scores.length ? Math.max(...scores) : 0;
}

function resetBall(direction = "left") {
  state.ball.x = pitch.clientWidth / 2;
  state.ball.y = pitch.clientHeight / 2;
  state.ball.vx = direction === "left" ? -5.5 : 5.5;
  state.ball.vy = (Math.random() * 2.8 + 2.0) * (Math.random() > 0.5 ? 1 : -1);
}

function render() {
  const pitchW = pitch.clientWidth;
  const pitchH = pitch.clientHeight;
  const player = state.player;
  const ai = state.ai;
  const ball = state.ball;

  playerEl.style.left = `${player.x - player.size / 2}px`;
  playerEl.style.top = `${player.y - player.size / 2}px`;

  aiEl.style.left = `${ai.x - ai.size / 2}px`;
  aiEl.style.top = `${ai.y - ai.size / 2}px`;

  ballEl.style.left = `${ball.x - ball.r}px`;
  ballEl.style.top = `${ball.y - ball.r}px`;

  scoreUserEl.textContent = state.score.user;
  scoreAiEl.textContent = state.score.ai;
  timerEl.textContent = String(Math.max(0, Math.ceil(state.timer)));
  bestScoreEl.textContent = String(getBestScore());

  if (ball.x < 0 || ball.x > pitchW) {
    if (ball.x < 0) {
      state.score.ai += 1;
    } else {
      state.score.user += 1;
    }

    resetBall(ball.x < 0 ? "right" : "left");
  }

  if (ball.y < 0 || ball.y > pitchH) {
    ball.vy *= -0.82;
    ball.y = clamp(ball.y, ball.r, pitchH - ball.r);
  }
}

function updatePlayer() {
  const player = state.player;
  const moveSpeed = 6.2;

  if (state.keys.left) player.vx = -moveSpeed;
  if (state.keys.right) player.vx = moveSpeed;
  if (!state.keys.left && !state.keys.right) player.vx *= 0.5;

  player.x += player.vx;
  player.x = clamp(player.x, 40, pitch.clientWidth - 40);

  player.vy += 0.7;
  player.y += player.vy;

  const ground = pitch.clientHeight - 50;
  if (player.y > ground) {
    player.y = ground;
    player.vy = 0;
  }

  if (state.keys.jump && player.y >= ground - 0.1) {
    player.vy = -15.5;
  }
}

function updateAI() {
  const ai = state.ai;
  const ball = state.ball;

  const targetX = ball.x > pitch.clientWidth * 0.48 ? ball.x : pitch.clientWidth * 0.72;

  ai.vx = (targetX - ai.x) * 0.08;
  ai.vy += 0.55;

  ai.x += ai.vx;
  ai.x = clamp(ai.x, 40, pitch.clientWidth - 40);

  ai.y += ai.vy;
  ai.y = clamp(ai.y, 50, pitch.clientHeight - 50);

  if (Math.abs(ball.x - ai.x) < 110 && Math.abs(ball.y - ai.y) < 90) {
    if (ai.y >= pitch.clientHeight - 70 && ball.y > ai.y - 20) {
      ai.vy = -14;
    }
  }
}

function updateBall() {
  const ball = state.ball;
  const player = state.player;
  const ai = state.ai;

  ball.x += ball.vx;
  ball.y += ball.vy;
  ball.vy += 0.18;

  const courtTop = 0;
  const courtBottom = pitch.clientHeight;
  const leftWall = 0;
  const rightWall = pitch.clientWidth;

  if (ball.y < courtTop + ball.r) {
    ball.y = courtTop + ball.r;
    ball.vy *= -0.9;
  }

  if (ball.y > courtBottom - ball.r) {
    ball.y = courtBottom - ball.r;
    ball.vy *= -0.9;
  }

  if (ball.x < leftWall + ball.r) {
    ball.x = leftWall + ball.r;
    ball.vx *= -0.96;
  }

  if (ball.x > rightWall - ball.r) {
    ball.x = rightWall - ball.r;
    ball.vx *= -0.96;
  }

  const playerDist = Math.hypot(ball.x - player.x, ball.y - player.y);
  if (playerDist < (ball.r + player.size / 2) * 0.9) {
    const angle = Math.atan2(ball.y - player.y, ball.x - player.x);
    ball.vx = Math.cos(angle) * 8.5;
    ball.vy = Math.sin(angle) * 7.4;
    ball.x = player.x + Math.cos(angle) * ((ball.r + player.size / 2) * 0.9 + 2);
    ball.y = player.y + Math.sin(angle) * ((ball.r + player.size / 2) * 0.9 + 2);
  }

  const aiDist = Math.hypot(ball.x - ai.x, ball.y - ai.y);
  if (aiDist < (ball.r + ai.size / 2) * 0.9) {
    const angle = Math.atan2(ball.y - ai.y, ball.x - ai.x);
    ball.vx = Math.cos(angle) * -8.6;
    ball.vy = Math.sin(angle) * 7.2;
    ball.x = ai.x + Math.cos(angle) * ((ball.r + ai.size / 2) * 0.9 + 2);
    ball.y = ai.y + Math.sin(angle) * ((ball.r + ai.size / 2) * 0.9 + 2);
  }
}

function setPhase(phase) {
  state.phase = phase;
  state.running = phase === "playing";

  if (phase === "start") {
    startScreen.classList.remove("hidden");
    gameShell.classList.add("hidden");
    resultScreen.classList.add("hidden");
  }

  if (phase === "playing") {
    startScreen.classList.add("hidden");
    gameShell.classList.remove("hidden");
    resultScreen.classList.add("hidden");
  }

  if (phase === "result") {
    startScreen.classList.add("hidden");
    gameShell.classList.add("hidden");
    resultScreen.classList.remove("hidden");
  }
}

function resetMatch() {
  state.timer = state.matchTime;
  state.score.user = 0;
  state.score.ai = 0;

  state.player.x = 140;
  state.player.y = 240;
  state.player.vx = 0;
  state.player.vy = 0;

  state.ai.x = 760;
  state.ai.y = 240;
  state.ai.vx = 0;
  state.ai.vy = 0;

  resetBall("left");
  statusTextEl.textContent = "Laufend";
  render();
}

function endMatch() {
  state.running = false;
  state.phase = "result";

  const userScore = state.score.user;
  const aiScore = state.score.ai;

  finalScoreEl.textContent = `${userScore} : ${aiScore}`;

  if (userScore > aiScore) {
    resultMessageEl.textContent = "Du hast gewonnen! Super Spiel!";
  } else if (userScore < aiScore) {
    resultMessageEl.textContent = "Der Computer war besser. Versuch es noch einmal!";
  } else {
    resultMessageEl.textContent = "Unentschieden! Ein erneuter Versuch lohnt sich.";
  }

  if (userScore > 0) {
    saveHighscore(userScore);
  }

  setPhase("result");
}

function startMatch() {
  resetMatch();
  setPhase("playing");
  lastTime = 0;
}

function gameLoop(timestamp) {
  if (state.phase === "playing") {
    const delta = (timestamp - lastTime) / 1000 || 0.016;
    lastTime = timestamp;

    updatePlayer();
    updateAI();
    updateBall();

    state.timer -= delta;
    if (state.timer <= 0) {
      endMatch();
    }

    render();
  }

  requestAnimationFrame(gameLoop);
}

document.addEventListener("keydown", (event) => {
  const key = event.key.toLowerCase();

  if (key === "arrowleft" || key === "a") state.keys.left = true;
  if (key === "arrowright" || key === "d") state.keys.right = true;
  if (key === "arrowup" || key === "w" || key === " ") {
    state.keys.jump = true;
    event.preventDefault();
  }
});

document.addEventListener("keyup", (event) => {
  const key = event.key.toLowerCase();

  if (key === "arrowleft" || key === "a") state.keys.left = false;
  if (key === "arrowright" || key === "d") state.keys.right = false;
  if (key === "arrowup" || key === "w" || key === " ") state.keys.jump = false;
});

startBtn.addEventListener("click", () => {
  startMatch();
});

playAgainBtn.addEventListener("click", () => {
  startMatch();
});

restartBtn.addEventListener("click", () => {
  startMatch();
});

emergencyBtn.addEventListener("click", () => {
  if (state.phase !== "playing") return;

  state.running = false;
  state.phase = "paused";
  overlay.classList.remove("hidden");
  overlay.setAttribute("aria-hidden", "false");
  calcDisplay.textContent = "0";
  calcHint.textContent = "Rechne 6 + 7, um das Spiel wieder zu öffnen.";
  calcExpression = "";
});

function closeCalculator() {
  overlay.classList.add("hidden");
  overlay.setAttribute("aria-hidden", "true");
  state.phase = "playing";
  state.running = true;
  calcExpression = "";
  calcDisplay.textContent = "0";
}

document.querySelectorAll(".calc-btn").forEach((button) => {
  button.addEventListener("click", () => {
    const value = button.dataset.value;

    if (value === "clear") {
      calcExpression = "";
      calcDisplay.textContent = "0";
      calcHint.textContent = "Rechne 6 + 7, um das Spiel wieder zu öffnen.";
      return;
    }

    if (value === "del") {
      calcExpression = calcExpression.slice(0, -1);
      calcDisplay.textContent = calcExpression || "0";
      return;
    }

    if (value === "equals") {
      try {
        const result = Function(`"use strict"; return (${calcExpression});`)();

        if (Number.isFinite(result)) {
          calcDisplay.textContent = String(result);

          if (Number(result) === 13) {
            calcHint.textContent = "Erfolgreich! Das Spiel ist wieder frei.";
            setTimeout(closeCalculator, 600);
            return;
          }

          calcHint.textContent = "Falsch! 6 + 7 = 13.";
          calcExpression = "";
          setTimeout(() => {
            calcDisplay.textContent = "0";
            calcHint.textContent = "Rechne 6 + 7, um das Spiel wieder zu öffnen.";
          }, 1200);
        }
      } catch {
        calcHint.textContent = "Ungültige Eingabe. Rechne 6 + 7.";
        calcExpression = "";
        calcDisplay.textContent = "0";
      }
      return;
    }

    if (calcExpression === "0" && !["+", "-", "*", "/", "."].includes(value)) {
      calcExpression = value;
    } else {
      calcExpression += value;
    }

    calcDisplay.textContent = calcExpression;
  });
});

renderHighscore();
bestScoreEl.textContent = String(getBestScore());
setPhase("start");
resetMatch();
requestAnimationFrame(gameLoop);
